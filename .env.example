# PostgreSQL Configuration
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow_secure_password
POSTGRES_DB=airflow

# MongoDB Configuration
MONGO_USER=admin
MONGO_PASSWORD=secure_password

# Airflow Configuration (Auto-generated UID, adjust as needed for your system)
AIRFLOW_UID=5000
AIRFLOW__WEBSERVER__DEFAULT_USER_USERNAME=airflow
AIRFLOW__WEBSERVER__DEFAULT_USER_PASSWORD=airflow

# Node Environment (development or production)
NODE_ENV=production

# API Configuration
API_PORT=5000
API_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000
